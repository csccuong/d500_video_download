<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="28dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Main Rating Container -->
            <LinearLayout
                android:id="@+id/layoutRatingMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:id="@+id/btnRatingClose"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="start"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/icon_close"
                    app:tint="@color/white" />

                <FrameLayout
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_circle_white">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_thumb_up" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tvRatingTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="@string/do_you_like_hd_video_downloader_player"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRatingDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/we_need_your_feedback_and_motivation_to"
                    android:textColor="#B0B0B0"
                    android:textSize="13sp" />

                <!-- 5 Stars -->
                <LinearLayout
                    android:id="@+id/layoutStars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivStar1"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_margin="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star_outline" />

                    <ImageView
                        android:id="@+id/ivStar2"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_margin="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star_outline" />

                    <ImageView
                        android:id="@+id/ivStar3"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_margin="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star_outline" />

                    <ImageView
                        android:id="@+id/ivStar4"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_margin="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star_outline" />

                    <ImageView
                        android:id="@+id/ivStar5"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_margin="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star_outline" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnRatingNoThanks"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_btn_blue"
                    android:gravity="center"
                    android:text="@string/no_thanks"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Thank You Container -->
            <LinearLayout
                android:id="@+id/layoutRatingThankYou"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="36dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btnThankYouClose"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="start"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/icon_close"
                    app:tint="@color/white" />

                <FrameLayout
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_circle_light_blue">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tvRatingThankYouTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/thank_you"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
